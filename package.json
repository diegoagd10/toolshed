{
  "name": "toolshed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci .",
    "test": "rm -rf dist-test && tsc && node --test --test-force-exit \"dist-test/**/*.test.js\"",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "24.19.4",
    "typescript": "7.0.2"
  }
}
