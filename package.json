{
  "name": "toolshed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "db:generate": "drizzle-kit generate",
    "lint": "vp check",
    "test": "vp test run",
    "coverage": "mcr -c mcr.config.ts -- vp test run",
    "check": "npm run lint && npm run build && npm run coverage"
  },
  "dependencies": {
    "@nestjs/common": "12.6.2",
    "@nestjs/core": "12.6.2",
    "@nestjs/platform-express": "12.6.2",
    "@nuintun/qrcode": "5.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pdf-lib": "1.17.1",
    "pngjs": "7.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "24.19.4",
    "@types/pngjs": "6.0.5",
    "drizzle-kit": "1.0.0-rc.5",
    "jsqr": "1.4.0",
    "monocart-coverage-reports": "3.2.1",
    "vite-plus": "1.8.0"
  },
  "engines": {
    "node": ">=24"
  }
}
