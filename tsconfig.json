{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "experimentalDecorators": true,
    "noEmit": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "lint", "vite.config.ts", "mcr.config.ts"]
}
