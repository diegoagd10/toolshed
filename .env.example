OWNER_PASSWORD=change-me
PUBLIC_URL=https://toolshed.example-tailnet.ts.net
ADMIN_URL=http://toolshed.example.lan
DATA=./data
# Megabytes that stored files may take. Defaults to 5120.
MAX_DISK_MB=5120
# A reusable, non-ephemeral Tailscale auth key tagged tag:toolshed, for the ts container.
TS_AUTHKEY=tskey-auth-change-me
